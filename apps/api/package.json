{
  "name": "@ai-job-search/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "npx prisma migrate deploy && node dist/main.js",
    "start:prod": "npx prisma migrate deploy && node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "create-workspace": "tsx scripts/create-workspace.ts",
    "clean-jobs": "tsx scripts/clean-duplicate-jobs.ts"
  },
  "dependencies": {
    "@ai-job-search/prompts": "workspace:*",
